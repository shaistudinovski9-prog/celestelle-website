# --- Server ---
DATABASE_URL=postgres://user:pass@localhost:5432/celestelle
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
PUBLIC_URL=http://localhost:5173

# First admin bootstrap (used once by patches.js if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=owner@celestelle.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- Payments (Milestone 3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Milestone 4) ---
# Optional. Without these, order/shipment emails are a no-op (logged, not sent).
# Provider: Resend (HTTP, no SDK). Swap providers by editing services/mailer.js.
RESEND_API_KEY=
MAIL_FROM=Celestelle <onboarding@resend.dev>

# --- Client (Vite) ---
VITE_API_URL=/api
